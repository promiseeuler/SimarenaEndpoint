{
  "name": "simarena-endpoint",
  "version": "0.1.0",
  "private": true,
  "description": "A versioned bridge between SimArena simulations and external robot brains.",
  "type": "module",
  "bin": {
    "simarena-compile": "dist/src/runner/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "compile:scene": "tsx src/runner/cli.ts",
    "start": "node dist/server.js",
    "test": "vitest run test",
    "test:watch": "vitest test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9",
    "ws": "^8.18.3"
  }
}
